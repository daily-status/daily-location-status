# --- Stage 1: Build ---
FROM node:22-alpine AS build
WORKDIR /app

# 1. Install dependencies first
COPY frontend/package*.json ./
RUN npm install

# 2. Copy Configuration and Source
COPY config /app/config
COPY frontend/ ./

# 3. Build Args
ARG FRONTEND_API_BASE_URL
ARG FRONTEND_DEV_SERVER_PORT
ARG FRONTEND_DEV_PROXY_TARGET

ENV FRONTEND_API_BASE_URL=${FRONTEND_API_BASE_URL} \
    FRONTEND_DEV_SERVER_PORT=${FRONTEND_DEV_SERVER_PORT} \
    FRONTEND_DEV_PROXY_TARGET=${FRONTEND_DEV_PROXY_TARGET}

RUN npm run build

# --- Stage 2: Runtime ---
FROM nginx:stable-alpine
RUN rm -rf /usr/share/nginx/html/*

# Copy from build stage (standard build output is /app/dist)
COPY --from=build /app/dist /usr/share/nginx/html

# Copy Nginx config using the root-relative path
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]