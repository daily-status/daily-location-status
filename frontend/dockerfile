# --- Stage 1: Build ---
FROM node:22-alpine AS build

# Set working directory
WORKDIR /app

# 1. Install dependencies first (Cache Optimization)
COPY frontend/package*.json ./
RUN npm install

# 2. Copy Configuration and Source
# We pull 'config' from the root and 'frontend' source code
COPY config /app/config
COPY frontend/ ./

# 3. Inject Build-Time Arguments
# Note: These are baked into the JS files at build time.
ARG FRONTEND_API_BASE_URL
ARG FRONTEND_DEV_SERVER_PORT
ARG FRONTEND_DEV_PROXY_TARGET

ENV FRONTEND_API_BASE_URL=${FRONTEND_API_BASE_URL} \
    FRONTEND_DEV_SERVER_PORT=${FRONTEND_DEV_SERVER_PORT} \
    FRONTEND_DEV_PROXY_TARGET=${FRONTEND_DEV_PROXY_TARGET}

# 4. Generate Production Build
RUN npm run build

# --- Stage 2: Runtime ---
FROM nginx:stable-alpine

# Clean default assets
RUN rm -rf /usr/share/nginx/html/*

# Copy built static files from the build stage
# Assuming your build output goes to /app/dist
COPY --from=build /app/dist /usr/share/nginx/html

# Copy custom Nginx configuration
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# Run Nginx in the foreground
CMD ["nginx", "-g", "daemon off;"]